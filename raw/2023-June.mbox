  1. \-rgeos::readWKT("MULTIPOLYGON(((34 54, 60 34, 60 54, 34 54),\n                               (50 50, 52 50, 52 48, 50 48, 50 50)),\n                              ((100 100, 150 100, 150 150, 100 150, 100 100),\n                               (120 120, 120 130, 130 130, 130 120, 120 120))))") at test-misc.R:50:2
