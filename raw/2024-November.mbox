+#ifndef NDEBUG
+#define H5_CHECK_OVERFLOW(var, vartype, casttype)                                                            \
+    do {                                                                                                     \
+        casttype _tmp_overflow = (casttype)(var);                                                            \
+        assert((var) == (vartype)_tmp_overflow);                                                             \
+    } while (0)
+#else /* NDEBUG */
